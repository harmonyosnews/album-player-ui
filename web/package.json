{
  "name": "apui",
  "description": "Album Player UI (APUI) — web interface for Album Player for Linux 2.19",
  "private": true,
  "version": "0.2.5",
  "license": "Apache-2.0",
  "author": "harmonyosnews",
  "homepage": "https://github.com/harmonyosnews/album-player-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/harmonyosnews/album-player-ui.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "check": "node scripts/check-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
